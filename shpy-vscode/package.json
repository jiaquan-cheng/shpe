{
  "name": "shpy-vscode",
  "displayName": "Shpy Shape Analyzer",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.60.0"
  },
  "activationEvents": [
    "onLanguage:python"
  ],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "Shpy",
      "properties": {
        "shpy.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Path to the Python interpreter used by the Shpy language server. Leave blank for automatic .venv detection."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}